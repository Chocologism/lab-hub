# Copy to /srv/lab-hub/config/app.env, owned by root with mode 0600.
# README defines NEW application behavior that must be implemented and tested first.
LABHUB_ENV=production
REQUIRE_EXISTING_DATABASE=1
LABHUB_DB_PATH=/app/data/labhub.db
LABHUB_SECRET_KEY=REPLACE_WITH_RANDOM_JWT_SECRET
LABHUB_INVITE_CODE=REPLACE_WITH_RANDOM_INVITE_CODE
LABHUB_MAIL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
LABHUB_ALLOWED_ORIGINS=https://hub.example.com
TZ=Asia/Shanghai
